# Required for Lime's three AI surfaces (global assistant, research assistant,
# and the "Others" asset document parser) to work.
#
# Create a key at https://openrouter.ai — the model used for every AI call
# (deepseek/deepseek-v4-flash-0731) is fixed in src/lib/ai/openrouter.ts, not
# configured via env var, so there's nothing else to set here.
OPENROUTER_API_KEY=

# Required for auth (magic link) and the net_worth_snapshots table.
# Find these under Project Settings -> API in your Supabase dashboard.

# The project's API URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# The project's anon/public key. Safe to expose to the browser — access to
# any table is restricted by Row Level Security (RLS) policies, not by
# keeping this key secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — used only by the one-time seed route
# (src/app/api/seed/route.ts). Never import this in a client component or
# expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
